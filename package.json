{
  "name": "code-search-mcp",
  "version": "1.0.0",
  "description": "Unified high-performance code search and structural refactoring MCP server combining ripgrep and ast-grep",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "code-search-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "node build.js",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-search",
    "ripgrep",
    "ast-grep",
    "refactoring",
    "ast"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joutvhu/code-search-mcp.git"
  },
  "homepage": "https://github.com/joutvhu/code-search-mcp#readme",
  "bugs": {
    "url": "https://github.com/joutvhu/code-search-mcp/issues"
  },
