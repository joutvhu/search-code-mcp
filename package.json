{
  "name": "search-code-mcp",
  "version": "1.0.2",
  "description": "Unified high-performance code search and structural refactoring MCP server combining ripgrep and ast-grep",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "search-code-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "check": "tsc --noEmit",
    "test": "npm run check && npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "search-code",
    "ripgrep",
    "ast-grep",
    "refactoring",
    "ast"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joutvhu/search-code-mcp.git"
  },
  "homepage": "https://github.com/joutvhu/search-code-mcp#readme",
  "bugs": {
    "url": "https://github.com/joutvhu/search-code-mcp/issues"
  },
  "license": "MIT",
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  }
