{
  "name": "code-search-mcp",
  "version": "1.0.0",
  "description": "Unified high-performance code search and structural refactoring MCP server combining ripgrep and ast-grep",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "code-search-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"if(process.platform!=='win32')require('fs').chmodSync('dist/index.js','755')\"",
    "start": "node dist/index.js",
    "dev": "tsc -w"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-search",
    "ripgrep",
    "ast-grep",
    "refactoring",
    "ast"
  ],
  "license": "MIT"
}
