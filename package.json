{
  "name": "code-search-mcp",
  "version": "1.0.0",
  "description": "Unified high-performance code search and structural refactoring MCP server combining ripgrep and ast-grep",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "code-search-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-search",
    "ripgrep",
    "ast-grep",
    "refactoring",
    "ast"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joutvhu/code-search-mcp.git"
  },
  "homepage": "https://github.com/joutvhu/code-search-mcp#readme",
  "bugs": {
    "url": "https://github.com/joutvhu/code-search-mcp/issues"
  },
  "license": "MIT",
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "clean": true,
    "minify": true,
    "banner": {
      "js": "import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);"
    },
    "noExternal": [
      "@modelcontextprotocol/sdk",
      "yaml",
      "zod"
    ]
  }
}
